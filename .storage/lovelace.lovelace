                      "series": [
                        {
                          "entity": "sensor.balboa_spa_automation_start_filtercycle_1",
                          "name": "Filtercykel 1",
                          "type": "area",
                          "yaxis_id": "background",
                          "color": "#4A90D9",
                          "opacity": 0.15,
                          "stroke_width": 0,
                          "curve": "straight",
                          "data_generator": "const fc = parseInt(entity.state); const len = parseFloat(hass.states['input_number.balboa_spa_automation_filter_cycle_length'].state); const today = new Date(); today.setHours(0, 0, 0, 0); const result = []; [0, 1].forEach(dayOffset => {\n  const base = today.getTime() + dayOffset * 86400000;\n  const start = base + fc * 3600000;\n  const end = start + len * 3600000;\n  if (dayOffset === 0) {\n    result.push([start - 1, null]);\n    result.push([start, 1]);\n    result.push([end, 1]);\n    result.push([end + 1, null]);\n  } else {\n    result.push([start, null]);\n    result.push([end, null]);\n  }\n}); return result;\n"
                        },
                        {
                          "entity": "sensor.balboa_spa_automation_start_filtercycle_2",
                          "name": "Filtercykel 2",
                          "type": "area",
                          "yaxis_id": "background",
                          "color": "#4A90D9",
                          "opacity": 0.15,
                          "stroke_width": 0,
                          "curve": "straight",
                          "data_generator": "const fc = parseInt(entity.state); const len = parseFloat(hass.states['input_number.balboa_spa_automation_filter_cycle_length'].state); const today = new Date(); today.setHours(0, 0, 0, 0); const result = []; [0, 1].forEach(dayOffset => {\n  const base = today.getTime() + dayOffset * 86400000;\n  const start = base + fc * 3600000;\n  const end = start + len * 3600000;\n  if (dayOffset === 0) {\n    result.push([start - 1, null]);\n    result.push([start, 1]);\n    result.push([end, 1]);\n    result.push([end + 1, null]);\n  } else {\n    result.push([start, null]);\n    result.push([end, null]);\n  }\n}); return result;\n"
                        },
                        {
                          "entity": "sensor.nordpool_kwh_se3_sek_3_10_0",
                          "type": "column",
                          "unit": "öre/kWh",
                          "yaxis_id": "price",
                          "data_generator": "const vat = (1 + (hass.states['input_number.electrical_consumption_rate_vat'].state * 1) / 100); const comp = hass.states['input_number.electrical_consumption_rate_compensation_manual'].state * 1; const tax = hass.states['input_number.electrical_consumption_rate_tax'].state * 1; const todayValues = entity.attributes.today || []; const tomorrowValues = entity.attributes.tomorrow || []; const baseToday = new Date(); baseToday.setHours(0, 0, 0, 0); const baseTomorrow = new Date(baseToday); baseTomorrow.setDate(baseTomorrow.getDate() + 1); const intervalMinutes = 15; const todayData = todayValues.map((value, index) => {\n  const timestamp = new Date(baseToday.getTime() + index * intervalMinutes * 60000).getTime();\n  const adjustedValue = ((value * 100) + comp + tax) * vat;\n  return [timestamp, adjustedValue];\n}); const tomorrowData = tomorrowValues.map((value, index) => {\n  const timestamp = new Date(baseTomorrow.getTime() + index * intervalMinutes * 60000).getTime();\n  const adjustedValue = ((value * 100) + comp + tax) * vat;\n  return [timestamp, adjustedValue];\n}); return [...todayData, ...tomorrowData];\n",
                          "color_threshold": [
                            {
                              "value": 0,
                              "color": "#2085e3"
                            },
                            {
                              "value": 10,
                              "color": "#04822e"
                            },
