                              "text": "kWh"
                            }
                          }
                        },
                        {
                          "id": "background",
                          "show": false,
                          "min": 0,
                          "max": 1
                        }
                      ],
                      "series": [
                        {
                          "entity": "sensor.electrical_load_slot_rating",
                          "name": "Bäst tid",
                          "type": "area",
                          "yaxis_id": "background",
                          "color": "#00B050",
                          "opacity": 0.2,
                          "stroke_width": 0,
                          "curve": "stepline",
                          "data_generator": "const slots = entity.attributes.slots || [];\nconst midnight = new Date();\nmidnight.setHours(0, 0, 0, 0);\nconst tomorrowValid =\n  hass.states['sensor.nordpool_kwh_se3_sek_3_10_0']\n    ?.attributes?.tomorrow_valid === true;\nreturn slots\n  .filter(s => s.hour < 24 || tomorrowValid)\n  .map(s => [\n    midnight.getTime() + s.hour * 3600000,\n    s.tier === 5 ? 1 : 0\n  ]);\n"
                        },
                        {
                          "entity": "sensor.electrical_load_slot_rating",
                          "name": "Bättre tid",
                          "type": "area",
                          "yaxis_id": "background",
                          "color": "#46C050",
                          "opacity": 0.2,
                          "stroke_width": 0,
                          "curve": "stepline",
                          "data_generator": "const slots = entity.attributes.slots || [];\nconst midnight = new Date();\nmidnight.setHours(0, 0, 0, 0);\nconst tomorrowValid =\n  hass.states['sensor.nordpool_kwh_se3_sek_3_10_0']\n    ?.attributes?.tomorrow_valid === true;\nreturn slots\n  .filter(s => s.hour < 24 || tomorrowValid)\n  .map(s => [\n    midnight.getTime() + s.hour * 3600000,\n    s.tier === 4 ? 1 : 0\n  ]);\n"
                        },
                        {
                          "entity": "sensor.electrical_load_slot_rating",
                          "name": "Bra tid",
                          "type": "area",
                          "yaxis_id": "background",
                          "color": "#92D050",
                          "opacity": 0.2,
                          "stroke_width": 0,
                          "curve": "stepline",
                          "data_generator": "const slots = entity.attributes.slots || [];\nconst midnight = new Date();\nmidnight.setHours(0, 0, 0, 0);\nconst tomorrowValid =\n  hass.states['sensor.nordpool_kwh_se3_sek_3_10_0']\n    ?.attributes?.tomorrow_valid === true;\nreturn slots\n  .filter(s => s.hour < 24 || tomorrowValid)\n  .map(s => [\n    midnight.getTime() + s.hour * 3600000,\n    s.tier === 3 ? 1 : 0\n  ]);\n"
                        },
                        {
                          "entity": "sensor.balboa_spa_automation_start_filtercycle_1",
                          "name": "Filtercykel 1",
                          "type": "area",
                          "yaxis_id": "background",
                          "color": "#4A90D9",
                          "opacity": 0.5,
                          "stroke_width": 0,
                          "curve": "straight",
                          "data_generator": "const fc = parseInt(entity.state); const len = parseFloat(hass.states['input_number.balboa_spa_automation_filter_cycle_length'].state); const today = new Date(); today.setHours(0, 0, 0, 0); const result = []; [0, 1].forEach(dayOffset => {\n  const base = today.getTime() + dayOffset * 86400000;\n  const start = base + fc * 3600000;\n  const end = start + len * 3600000;\n  if (dayOffset === 0) {\n    result.push([start - 1, null]);\n    result.push([start, 1]);\n    result.push([end, 1]);\n    result.push([end + 1, null]);\n  } else {\n    result.push([start, null]);\n    result.push([end, null]);\n  }\n}); return result;\n"
                        },
                        {
                          "entity": "sensor.balboa_spa_automation_start_filtercycle_2",
                          "name": "Filtercykel 2",
                          "type": "area",
                          "yaxis_id": "background",
                          "color": "#4A90D9",
                          "opacity": 0.5,
                          "stroke_width": 0,
                          "curve": "straight",
                          "data_generator": "const fc = parseInt(entity.state); const len = parseFloat(hass.states['input_number.balboa_spa_automation_filter_cycle_length'].state); const today = new Date(); today.setHours(0, 0, 0, 0); const result = []; [0, 1].forEach(dayOffset => {\n  const base = today.getTime() + dayOffset * 86400000;\n  const start = base + fc * 3600000;\n  const end = start + len * 3600000;\n  if (dayOffset === 0) {\n    result.push([start - 1, null]);\n    result.push([start, 1]);\n    result.push([end, 1]);\n    result.push([end + 1, null]);\n  } else {\n    result.push([start, null]);\n    result.push([end, null]);\n  }\n}); return result;\n"
                        },
                        {
                          "entity": "sensor.nordpool_kwh_se3_sek_3_10_0",
                          "fill_raw": "null",
                          "type": "area",
                          "stroke_width": 1,
                          "opacity": 0.2,
                          "unit": "öre/kWh",
                          "yaxis_id": "price",
                          "extend_to": false,
                          "data_generator": "const vat = (1 + (hass.states['input_number.electrical_consumption_rate_vat'].state * 1) / 100); const comp = hass.states['input_number.electrical_consumption_rate_compensation_manual'].state * 1; const tax = hass.states['input_number.electrical_consumption_rate_tax'].state * 1; const tomorrow = hass.states['sensor.nordpool_kwh_se3_sek_3_10_0']?.attributes?.tomorrow; const tomorrowValid = tomorrow !== false && hass.states['sensor.nordpool_kwh_se3_sek_3_10_0']?.attributes?.tomorrow_valid === true; const todayValues = entity.attributes.today || []; const tomorrowValues = tomorrowValid ? (entity.attributes.tomorrow || []) : []; const baseToday = new Date(); baseToday.setHours(0, 0, 0, 0); const baseTomorrow = new Date(baseToday); baseTomorrow.setDate(baseTomorrow.getDate() + 1); const intervalMinutes = 15; const todayData = todayValues.map((value, index) => {\n  const timestamp = new Date(baseToday.getTime() + index * intervalMinutes * 60000).getTime();\n  const adjustedValue = ((value * 100) + comp + tax) * vat;\n  return [timestamp, adjustedValue];\n}); const tomorrowData = tomorrowValues.map((value, index) => {\n  const timestamp = new Date(baseTomorrow.getTime() + index * intervalMinutes * 60000).getTime();\n  const adjustedValue = ((value * 100) + comp + tax) * vat;\n  return [timestamp, adjustedValue];\n}); const result = [...todayData, ...tomorrowData]; if (!tomorrowValid && result.length > 0) {\n  result.push([baseTomorrow.getTime(), null]);\n} return result;\n",
                          "color_threshold": [
                            {
                              "value": 0,
                              "color": "#2085e3"
                            },
                            {
                              "value": 10,
                              "color": "#04822e"
                            },
                            {
                              "value": 15,
                              "color": "#12A141"
                            },
                            {
                              "value": 30,
                              "color": "#79B92C"
                            },
                            {
                              "value": 35,
                              "color": "#C4D81D"
                            },
                            {
                              "value": 40,
                              "color": "#F3DC0C"
                            },
                            {
                              "value": 45,
                              "color": "#F4C616"
                            },
                            {
                              "value": 50,
                              "color": "#EFA51E"
                            },
                            {
                              "value": 55,
                              "color": "#E76821"
                            },
                            {
                              "value": 100,
                              "color": "#E33F20"
                            },
                            {
                              "value": 200,
                              "color": "#DC182F"
                            }
                          ]
                        },
                        {
                          "entity": "sensor.total_yield",
                          "name": "Faktisk solel [kWh]",
                          "type": "line",
                          "yaxis_id": "wh",
                          "color": "#FFD700",
                          "opacity": 1,
                          "stroke_width": 3,
                          "extend_to": false,
                          "statistics": {
                            "type": "change",
                            "period": "hour"
                          }
                        },
                        {
                          "entity": "sensor.solar_forecast_home_south_east",
                          "name": "Solprognos totalt [kWh]",
                          "type": "line",
                          "unit": "kWh",
                          "yaxis_id": "wh",
                          "color": "#FFD700",
                          "stroke_width": 3,
                          "curve": "smooth",
                          "stroke_dash": 6,
                          "data_generator": "const se = hass.states['sensor.solar_forecast_home_south_east']; const s = hass.states['sensor.solar_forecast_home_south']; const seData = se?.attributes?.watt_hours_period || {}; const sData  = s?.attributes?.watt_hours_period  || {}; const allKeys = new Set([\n  ...Object.keys(seData),\n  ...Object.keys(sData)\n]); const result = []; allKeys.forEach(key => {\n  const ts  = new Date(key).getTime();\n  const val = ((seData[key] || 0) + (sData[key] || 0)) / 1000;\n  if (!isNaN(ts)) result.push([ts, val]);\n}); result.sort((a, b) => a[0] - b[0]); return result;\n"
                        }
                      ]
                    }
