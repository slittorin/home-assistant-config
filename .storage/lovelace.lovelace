                          "entity": "sensor.nordpool_kwh_se3_sek_3_10_0",
                          "type": "column",
                          "unit": "öre/kWh",
                          "data_generator": "const vat = (1 + (hass.states['input_number.electrical_consumption_rate_vat'].state * 1) / 100);\nconst comp = hass.states['input_number.electrical_consumption_rate_compensation_manual'].state * 1;\nconst tax = hass.states['input_number.electrical_consumption_rate_tax'].state * 1;\nconst todayValues = entity.attributes.today || [];\nconst tomorrowValues = entity.attributes.tomorrow || [];\nconst baseToday = new Date();\nbaseToday.setHours(0, 0, 0, 0);\nconst baseTomorrow = new Date(baseToday);\nbaseTomorrow.setDate(baseTomorrow.getDate() + 1);\nconst intervalMinutes = 15;\n\nconst todayData = todayValues.map((value, index) => {\n  const timestamp = new Date(baseToday.getTime() + index * intervalMinutes * 60000).getTime();\n  const adjustedValue = ((value * 100) + comp + tax) * vat;\n  return [timestamp, adjustedValue];\n});\nconst tomorrowData = tomorrowValues.map((value, index) => {\n  const timestamp = new Date(baseTomorrow.getTime() + index * intervalMinutes * 60000).getTime();\n  const adjustedValue = ((value * 100) + comp + tax) * vat;\n  return [timestamp, adjustedValue];\n});\n\nreturn [...todayData, ...tomorrowData];\n",
